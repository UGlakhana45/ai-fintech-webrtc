# Required on Vercel / HTTPS: public https:// URL of your Socket.io server (see README.md).
NEXT_PUBLIC_SIGNALING_URL=

# Optional. Default 3001. Used only for LAN http:// dev when inferring signaling from the page host.
NEXT_PUBLIC_SIGNALING_PORT=3001

# Optional. Next dev only: comma-separated hostnames for allowedDevOrigins (LAN IP), no http://.
ALLOWED_DEV_ORIGINS=
